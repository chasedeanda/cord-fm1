+  const snap = (scale, tonic, note) => {
+    const p = pcs(scale);
+    for (let d = 0; d < 12; d++) {
+      if (note + d <= 127 && p.includes(mod(note + d - tonic, 12))) return note + d;
+      if (note - d >= 0 && p.includes(mod(note - d - tonic, 12))) return note - d;
+    }
