+    ArrowLeft: () => move(m, -1), ArrowRight: () => move(m, 1), ArrowUp: () => { pitch(m, 1); preview(); }, ArrowDown: () => { pitch(m, -1); preview(); },
+    Enter: () => { if (toggle(m) === 1) preview(); }, " ": () => { if (toggle(m) === 1) preview(); },
