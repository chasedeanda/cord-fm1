+      g.fillStyle = tonic ? acc : mut; g.fillText(nn >= 0 && nn <= 127 ? noteName(nn) : "", 6, y + rh / 2);
+      g.fillStyle = line; g.fillRect(KEYW, y + rh - 1, w - KEYW, 1);
+    }
+    for (let s = 0; s <= n; s++) { g.fillStyle = s % 4 === 0 ? line : surf; g.fillRect(KEYW + s * cw, 0, s % 16 === 0 ? 2 : 1, h); }
